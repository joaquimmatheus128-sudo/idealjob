<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Idealjob</title>
    <meta name="description" content="Idealjob é uma plataforma de empregos focada em gerenciamento socioemocional no trabalho">
    <meta name="keywords" content="Idealjob, empregos, trabalho, gerenciamento socioemocional, desenvolvimento pessoal, carreira, oportunidades de emprego">
    <meta name="author" content="Matheus Joaquim e Kaua Moreira">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header class="site-header">
        <nav class="top-menu" aria-label="Menu principal">
            <a class="brand" href="#home" aria-label="Ideal Job, início">
                <span>Ideal<br>Job.</span>
                <svg class="brand-fish" viewBox="0 0 48 20" aria-hidden="true">
                    <path d="M2 10c8-8 22-8 32 0-10 8-24 8-32 0Zm32 0 12-7v14l-12-7Z" />
                </svg>
            </a>
            <ul class="menu-links">
                <li><a href="#home">home</a></li>
                <li><a href="#sobre">Sobre</a></li>
                <li><a href="#servicos">Serviços</a></li>
                <li><a href="#contato">Contato</a></li>
            </ul>
            <div class="social-links" aria-label="Redes sociais">
                <a href="https://wa.me/" aria-label="WhatsApp"><img src="assets/Brand Whatsapp.svg" alt=""></a>
                <a href="https://instagram.com/" aria-label="Instagram"><img src="assets/Brand Instagram.svg" alt=""></a>
            </div>
        </nav>
    </header>
</body>
</html>
